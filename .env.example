# Discord Bot Configuration Template
# 複製此文件為 .env 並填入實際的值

# Discord Bot Token
# 獲取方式：https://discord.com/developers/applications
TOKEN=your_discord_bot_token_here

# 數據庫 URL
# 本地開發使用 SQLite，生產環境可改為 PostgreSQL
DATABASE_URL=file:./prisma/dev.db

# OpenAI 配置（可選）
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini 配置（推薦使用 - 免費）
# 獲取方式：https://ai.google.dev/
GOOGLE_GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# LLM 提供商選擇
# 可選值：gemini, openai
LLM_PROVIDER=gemini

# Redis 連接
# 本地開發：redis://localhost:6379
# Docker Compose：redis://redis:6379（自動連接 redis 服務）
REDIS_URL=redis://redis:6379

# Optional: Pinecone Vector Database（可選）
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_ENVIRONMENT=your_pinecone_env
# PINECONE_INDEX=your_pinecone_index
